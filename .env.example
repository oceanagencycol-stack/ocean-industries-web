IG_ACCESS_TOKEN=
IG_USER_ID=

# n8n — webhook del agente conversacional
N8N_WEBHOOK_URL=

# Wompi — secreto de integridad para firmar/validar pagos (/api/pago-wompi)
WOMPI_INTEGRITY_SECRET=
